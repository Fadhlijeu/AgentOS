{
  "name": "agentos-workspace",
  "version": "0.1.0",
  "description": "AgentOS — The runtime for AI agents that operate computers.",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "typecheck": "tsc --noEmit && pnpm -r exec tsc --noEmit",
    "test": "npx tsx agentos/tests/e2e-verification.ts && npx tsx agentos/tests/security-hardening.test.ts && npx tsx agentos/tests/lifecycle-concurrency.test.ts && npx tsx agentos/tests/memory-http-replay.test.ts && npx tsx agentos/tests/workspace-browser-runtime.test.ts",
    "test:security": "npx tsx agentos/tests/security-hardening.test.ts",
    "test:lifecycle": "npx tsx agentos/tests/lifecycle-concurrency.test.ts",
    "test:phase3": "npx tsx agentos/tests/memory-http-replay.test.ts",
    "test:phase4": "npx tsx agentos/tests/workspace-browser-runtime.test.ts",
    "example:basic": "npx tsx agentos/examples/basic-agent.ts",
    "example:filesystem": "npx tsx agentos/examples/filesystem-agent.ts",
    "playground": "npx tsx agentos/apps/playground/src/index.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "@types/node": "^22.0.0",
    "@types/better-sqlite3": "^7.6.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
