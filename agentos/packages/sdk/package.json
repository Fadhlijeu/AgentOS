{
  "name": "@agentos/sdk",
  "version": "0.1.0",
  "description": "AgentOS SDK — TypeScript/JavaScript client for building applications on AgentOS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@agentos/core": "workspace:*",
    "@agentos/runtime": "workspace:*",
    "@agentos/agent": "workspace:*",
    "@agentos/tools": "workspace:*",
    "@agentos/permissions": "workspace:*",
    "@agentos/events": "workspace:*",
    "@agentos/planner": "workspace:*",
    "@agentos/memory": "workspace:*",
    "@agentos/storage": "workspace:*",
    "@agentos/observability": "workspace:*",
    "@agentos/adapters": "workspace:*"
  }
}